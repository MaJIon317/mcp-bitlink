NODE_ENV=development
HOST=0.0.0.0
PORT=3500
CORS_ORIGIN=*

CRYPTO_API_BASE_URL=
CRYPTO_API_TIMEOUT_MS=10000

MCP_SERVER_NAME=bitlink
MCP_SERVER_VERSION=0.1.0
LOG_LEVEL=info

# OAuth is the default. Register this server as a Bitlink Passport client.
AUTH_MODE=oauth
# Public endpoint used as the OAuth resource and to render client configuration.
BITLINK_MCP_URL=
# Bitlink application origin, without /api/v1.
BITLINK_OAUTH_BASE_URL=
BITLINK_OAUTH_CLIENT_ID=
BITLINK_OAUTH_CLIENT_SECRET=
# Stable AES-256 key, base64 encoded; generate once and store securely.
OAUTH_ENCRYPTION_KEY=
OAUTH_STORE_PATH=.local/oauth.sqlite
# Trusted HTTPS origins for fetching client metadata (CIMD).
OAUTH_CLIENT_METADATA_ORIGINS=https://chatgpt.com
# Optional static clients for Postman/legacy registration; CIMD needs no entry.
OAUTH_CLIENTS_JSON=
